# ==============================================================================
# 🌐 ENVIRONMENT CONFIGURATION TEMPLATE
# Interactive Developer & Automation Portfolio
# Stack: Django 6.1 (Python 3.14) + Next.js 16.4 + Supabase PostgreSQL 17 + Vercel
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE DATABASE CONFIGURATION (PostgreSQL 17)
# ------------------------------------------------------------------------------
# ⚠️ KRİTİK: Vercel Serverless ortamında Supabase Supavisor Transaction Pooler (Port 6543) kullanılmalıdır!
# Format: postgresql://[user].[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/[db-name]?sslmode=require
DATABASE_URL="postgresql://postgres.yourprojectref:your-strong-password@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Opsiyonel: Supabase Direct Connection (Port 5432 - Sadece migration veya lokal DDL işlemleri için)
DIRECT_URL="postgresql://postgres.yourprojectref:your-strong-password@aws-0-eu-central-1.pooler.supabase.com:5432/postgres?sslmode=require"

# Supabase API & Storage Credentials (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://yourprojectref.supabase.co"
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# ------------------------------------------------------------------------------
# 2. DJANGO 6.1 BACKEND CONFIGURATION
# ------------------------------------------------------------------------------
# 50+ karakter rastgele güvenli anahtar (örn: python -c 'import secrets; print(secrets.token_urlsafe(50))')
DJANGO_SECRET_KEY="django-insecure-change-me-to-a-super-secret-key-for-production"

# Canlıda (Production) DAİMA False olmalıdır
DJANGO_DEBUG="False"

# İzin verilen host adresleri (virgülle ayrılmış)
DJANGO_ALLOWED_HOSTS=".vercel.app,localhost,127.0.0.1"

# CORS İzinleri (Frontend Vercel URL'si ve yerel geliştirme adresi)
CORS_ALLOWED_ORIGINS="http://localhost:3000,https://your-portfolio-frontend.vercel.app"

# Rate Limiting & Bot Koruması
CONTACT_RATE_LIMIT="5/m"

# ------------------------------------------------------------------------------
# 3. NEXT.JS 16.4 FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
# Django Backend API adresi
NEXT_PUBLIC_API_URL="https://your-portfolio-backend.vercel.app/api"

# Supabase Client Erişim Bilgileri (Public & Browser Safe)
NEXT_PUBLIC_SUPABASE_URL="https://yourprojectref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Frontend Canlı Domain Adresi (SEO, OpenGraph ve Sitemap için)
NEXT_PUBLIC_SITE_URL="https://your-portfolio.vercel.app"
