# Django Configuration
DJANGO_SECRET_KEY=django-insecure-portfolio-prod-key-change-in-production-314
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Supabase PostgreSQL 17 (Supavisor Transaction Mode - Port 6543)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# If left empty, backend falls back gracefully to SQLite for local development
DATABASE_URL=
